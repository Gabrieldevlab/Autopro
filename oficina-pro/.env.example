# ─────────────────────────────────────────────────
#  COPIE ESTE ARQUIVO PARA .env.local E PREENCHA
#  Nunca suba .env.local para o GitHub!
# ─────────────────────────────────────────────────

# Supabase → Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Supabase → Settings → API → anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase → Settings → API → service_role key (NUNCA expor no frontend)
# Usado apenas em server actions / API routes
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
